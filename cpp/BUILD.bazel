# Root BUILD file for GraphAr C++ Bazel build.

load("@rules_cc//cc:defs.bzl", "cc_library")

# ------------------------------------------------------------------------------
# Top-level aliases for convenience
# ------------------------------------------------------------------------------

# Alias to the main graphar library
alias(
    name = "graphar",
    actual = "//src/graphar",
    visibility = ["//visibility:public"],
)

# ------------------------------------------------------------------------------
# Documentation generation (optional)
# ------------------------------------------------------------------------------
# To generate docs, install doxygen and run:
#   doxygen Doxyfile
# This is not integrated into the Bazel build since Doxygen is not
# available on BCR.

# ------------------------------------------------------------------------------
# Code formatting (clang-format)
# ------------------------------------------------------------------------------
# To format code, install clang-format and run:
#   clang-format --style=file -i src/graphar/*.h src/graphar/*.cc \
#       test/*.h test/*.cc examples/*.h examples/*.cc \
#       benchmarks/*.h benchmarks/*.cc

# ------------------------------------------------------------------------------
# Cpplint
# ------------------------------------------------------------------------------
# To run cpplint:
#   python misc/cpplint.py --root=include \
#       src/graphar/*.h src/graphar/*.cc \
#       test/*.h test/*.cc examples/*.h examples/*.cc \
#       benchmarks/*.h benchmarks/*.cc
