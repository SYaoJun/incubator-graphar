module(
    name = "graphar",
    version = "0.13.0",
)

# ------------------------------------------------------------------------------
# Bazel dependencies
# ------------------------------------------------------------------------------

# C++ rules
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "platforms", version = "1.0.0")

# For building non-Bazel (CMake/Make) dependencies
# NOTE: rules_foreign_cc is pulled transitively by google_benchmark -> libpfm.
# Force a newer version compatible with Bazel 9.
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# ------------------------------------------------------------------------------
# Test-only dependencies
# ------------------------------------------------------------------------------
bazel_dep(name = "catch2", version = "3.8.0")
bazel_dep(name = "google_benchmark", version = "1.9.1")

# ------------------------------------------------------------------------------
# Single version overrides for compatibility with Bazel 9
# ------------------------------------------------------------------------------
single_version_override(
    module_name = "rules_foreign_cc",
    version = "0.15.1",
)

# ------------------------------------------------------------------------------
# Arrow dependency
#
# Two strategies, controlled by the GAR_ARROW_SOURCE environment variable:
#
#   GAR_ARROW_SOURCE=1  bazel build //src/graphar   → build Arrow from source
#   bazel build //src/graphar                        → use system Arrow (default)
#
# Requires: cmake and ninja (only for source build).
# ------------------------------------------------------------------------------
arrow_ext = use_extension("//bazel:arrow_extension.bzl", "arrow")
use_repo(arrow_ext, "arrow")
