load("@rules_cc//cc:defs.bzl", "cc_test")

# ------------------------------------------------------------------------------
# Common test settings
# ------------------------------------------------------------------------------
TEST_COPTS = [
    "-fPIC",
]

TEST_DEFINES = [
    "DARROW_ORC",
]

# Common test dependencies
TEST_DEPS = [
    "//src/graphar",
    "//thirdparty:result",
    "@catch2//:catch2_main",
]

# Test data directory is set via the GAR_TEST_DATA environment variable.
# When running tests, set it like:
#   bazel test --test_env=GAR_TEST_DATA=/path/to/testing //test:all

# ------------------------------------------------------------------------------
# Test helper library
# ------------------------------------------------------------------------------
cc_library(
    name = "test_util",
    hdrs = ["util.h"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = [
        "//src/graphar",
    ],
)

# ------------------------------------------------------------------------------
# Individual test targets
#
# Each test corresponds to a test file from the original CMake configuration.
# ------------------------------------------------------------------------------

cc_test(
    name = "test_info",
    size = "medium",
    srcs = ["test_info.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_arrow_chunk_reader",
    size = "medium",
    srcs = ["test_arrow_chunk_reader.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_arrow_chunk_writer",
    size = "medium",
    srcs = ["test_arrow_chunk_writer.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_builder",
    size = "medium",
    srcs = ["test_builder.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_chunk_info_reader",
    size = "small",
    srcs = ["test_chunk_info_reader.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_graph",
    size = "medium",
    srcs = ["test_graph.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_multi_label",
    size = "medium",
    srcs = ["test_multi_label.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

cc_test(
    name = "test_multi_property",
    size = "medium",
    srcs = ["test_multi_property.cc"],
    copts = TEST_COPTS,
    defines = TEST_DEFINES,
    deps = TEST_DEPS + [":test_util"],
    env = {"GAR_TEST_DATA": "../../testing"},
)

# ------------------------------------------------------------------------------
# Convenience test suite
# ------------------------------------------------------------------------------
test_suite(
    name = "all_tests",
    tests = [
        ":test_info",
        ":test_arrow_chunk_reader",
        ":test_arrow_chunk_writer",
        ":test_builder",
        ":test_chunk_info_reader",
        ":test_graph",
        ":test_multi_label",
        ":test_multi_property",
    ],
)
