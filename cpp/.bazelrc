# ------------------------------------------------------------------------------
# Build settings
# ------------------------------------------------------------------------------

# Default to C++20 (required by Arrow >= 24.0.0)
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Compiler flags (matching CMakeLists.txt settings)
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wno-unused-parameter
build --copt=-Wno-unused-function
build --copt=-Wno-empty-body

# Treat warnings as errors (match CMake)
build --copt=-Werror

# Release defaults
build --compilation_mode=opt
build --copt=-O3
build --copt=-g

# Debug configuration
build:debug --compilation_mode=dbg
build:debug --copt=-O0
build:debug --copt=-fno-omit-frame-pointer
build:debug --copt=-fsanitize=address
build:debug --linkopt=-fsanitize=address

# Coverage configuration
build:coverage --compilation_mode=dbg
build:coverage --copt=--coverage
build:coverage --linkopt=--coverage

# Static build
build:static --dynamic_mode=off

# ------------------------------------------------------------------------------
# Platform-specific settings
# ------------------------------------------------------------------------------
build:linux --copt=-fPIC
build:linux --linkopt=-Wl,-rpath,$ORIGIN

build:macos --copt=-fPIC

# ------------------------------------------------------------------------------
# Test settings
# ------------------------------------------------------------------------------
test --test_output=errors
