load("@rules_cc//cc:defs.bzl", "cc_library")

# ------------------------------------------------------------------------------
# mini-yaml - lightweight YAML parser (embedded source)
# ------------------------------------------------------------------------------
cc_library(
    name = "mini_yaml",
    srcs = ["mini-yaml/yaml/Yaml.cpp"],
    hdrs = ["mini-yaml/yaml/Yaml.hpp"],
    copts = [
        "-w",  # Suppress all warnings from third-party code
        "-fPIC",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# ------------------------------------------------------------------------------
# result - header-only Result<T, E> type
# ------------------------------------------------------------------------------
cc_library(
    name = "result",
    hdrs = ["result/result.hpp"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# ------------------------------------------------------------------------------
# simple-uri-parser - header-only URI parser
# ------------------------------------------------------------------------------
cc_library(
    name = "uri_parser",
    hdrs = ["simple-uri-parser/uri_parser.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
