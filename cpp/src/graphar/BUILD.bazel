load("@rules_cc//cc:defs.bzl", "cc_library")

# ------------------------------------------------------------------------------
# Compiler flags shared across all graphar targets
# ------------------------------------------------------------------------------
GAR_COPTS = [
    "-fPIC",
]

GAR_DEFINES = [
    "DARROW_ORC",
]

# ------------------------------------------------------------------------------
# graphar core library
#
# This is the main GraphAr C++ library, built as a shared library by default.
# It includes all source files under src/graphar/ and depends on:
#   - Arrow C++ (arrow, arrow_acero, arrow_dataset, parquet)
#   - mini-yaml (thirdparty)
#   - result (thirdparty)
#   - uri-parser (thirdparty)
# ------------------------------------------------------------------------------

# All header files (for install/distribution)
filegroup(
    name = "public_headers",
    srcs = glob([
        "*.h",
        "api/*.h",
        "arrow/*.h",
        "high-level/*.h",
    ]),
    visibility = ["//visibility:public"],
)

# All source files
filegroup(
    name = "all_srcs",
    srcs = glob([
        "*.cc",
        "arrow/*.cc",
        "high-level/*.cc",
    ]),
)

cc_library(
    name = "graphar",
    srcs = [":all_srcs"],
    hdrs = [":public_headers"],
    copts = GAR_COPTS,
    defines = GAR_DEFINES,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//thirdparty:mini_yaml",
        "//thirdparty:result",
        "//thirdparty:uri_parser",
        "@arrow//:arrow",
        "@arrow//:arrow_acero",
        "@arrow//:arrow_dataset",
        "@arrow//:parquet",
    ],
)
