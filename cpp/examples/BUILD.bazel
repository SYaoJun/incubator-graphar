# ------------------------------------------------------------------------------
# Graph algorithm examples (REQUIRE Boost Graph Library)
#
# To build these, you need Boost installed on your system.
# Add the following to your .bazelrc or use --copt and --linkopt:
#
#   build:boost --copt=-isystem/usr/include
#   build:boost --linkopt=-L/usr/lib/x86_64-linux-gnu
#   build:boost --linkopt=-lboost_graph
#
# Then build with: bazel build --config=boost //examples:bfs_father_example
#
# Or better: add a boost_extension to MODULE.bazel that downloads and
# builds Boost using rules_foreign_cc.
# ------------------------------------------------------------------------------

