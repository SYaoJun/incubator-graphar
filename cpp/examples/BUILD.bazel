load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ------------------------------------------------------------------------------
# Common settings for examples
# ------------------------------------------------------------------------------
EXAMPLE_COPTS = [
    "-fPIC",
]

EXAMPLE_DEFINES = [
    "DARROW_ORC",
]

# ------------------------------------------------------------------------------
# Example configuration header
# ------------------------------------------------------------------------------
cc_library(
    name = "example_config",
    hdrs = ["config.h"],
    copts = EXAMPLE_COPTS,
    defines = EXAMPLE_DEFINES,
    deps = [
        "//src/graphar",
    ],
)

# ------------------------------------------------------------------------------
# Boost is required for graph algorithm examples (BFS, PageRank, CC, etc.).
#
# Boost is NOT available on BCR. You have two options:
#
# Option 1: Install Boost system-wide and use --define=BOOST_ROOT=/path/to/boost
#           with the boost_dep select() below.
#
# Option 2: Uncomment and use rules_foreign_cc to build Boost from source
#           (add boost to MODULE.bazel arrow_extension or a separate extension).
#
# For now, examples that don't require Boost can be built directly.
# Graph algorithm examples are disabled by default.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Examples that do NOT require Boost
# ------------------------------------------------------------------------------

cc_binary(
    name = "construct_info_example",
    srcs = ["construct_info_example.cc"],
    copts = EXAMPLE_COPTS,
    defines = EXAMPLE_DEFINES,
    deps = [
        ":example_config",
        "//src/graphar",
    ],
)

cc_binary(
    name = "low_level_reader_example",
    srcs = ["low_level_reader_example.cc"],
