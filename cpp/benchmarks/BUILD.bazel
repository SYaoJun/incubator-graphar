load("@rules_cc//cc:defs.bzl", "cc_binary")

# ------------------------------------------------------------------------------
# Common benchmark settings
# ------------------------------------------------------------------------------
BENCH_COPTS = [
    "-fPIC",
    "-O3",
]

BENCH_DEFINES = [
    "DARROW_ORC",
]

# Common benchmark dependencies
BENCH_DEPS = [
    "//src/graphar",
    "//thirdparty:result",
    "@google_benchmark//:benchmark_main",
]

# ------------------------------------------------------------------------------
# Benchmark utility header
# ------------------------------------------------------------------------------
cc_library(
    name = "benchmark_util",
    hdrs = ["benchmark_util.h"],
    copts = BENCH_COPTS,
    defines = BENCH_DEFINES,
    deps = [
        "//src/graphar",
        "@google_benchmark//:benchmark",
    ],
)

# ------------------------------------------------------------------------------
# Individual benchmark targets
# ------------------------------------------------------------------------------

cc_binary(
    name = "arrow_chunk_reader_benchmark",
    srcs = ["arrow_chunk_reader_benchmark.cc"],
    copts = BENCH_COPTS,
    defines = BENCH_DEFINES,
    deps = BENCH_DEPS + [":benchmark_util"],
)

cc_binary(
    name = "graph_info_benchmark",
    srcs = ["graph_info_benchmark.cc"],
    copts = BENCH_COPTS,
    defines = BENCH_DEFINES,
    deps = BENCH_DEPS + [":benchmark_util"],
)

cc_binary(
    name = "label_filter_benchmark",
    srcs = ["label_filter_benchmark.cc"],
    copts = BENCH_COPTS,
    defines = BENCH_DEFINES,
    deps = BENCH_DEPS + [":benchmark_util"],
)

# ------------------------------------------------------------------------------
# Convenience alias
# ------------------------------------------------------------------------------
filegroup(
    name = "all_benchmarks",
    srcs = [
        ":arrow_chunk_reader_benchmark",
        ":graph_info_benchmark",
        ":label_filter_benchmark",
    ],
)
